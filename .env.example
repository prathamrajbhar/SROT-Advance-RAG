# ==============================================================================
# SROT Enterprise Multimodal RAG - Environment Template (.env.example)
# ==============================================================================

# 1. Primary PostgreSQL Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:7006/postgres
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:7006/postgres

# 2. Vector Database & Cache Infrastructure
REDIS_URL=redis://localhost:7379/0
CELERY_BROKER_URL=redis://localhost:7379/1
CELERY_RESULT_BACKEND=redis://localhost:7379/2

QDRANT_URL=http://localhost:7333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=srot_enterprise_rag

# 3. AWS S3 Object Storage (Direct Multipart Ingestion)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=srot
# Custom endpoint for LocalStack/Floci (or leave blank for standard AWS S3)
S3_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
S3_PRESIGNED_EXPIRY_SECONDS=3600

# 4. Cryptographic Vault (AES-256-GCM 32-Byte Hex Key)
ENCRYPTION_MASTER_KEY=your_32_byte_hex_encryption_key

# 5. Local Model & In-Memory Inference Caches
FLASHRANK_CACHE_DIR=/tmp/flashrank_cache
OLLAMA_BASE_URL=http://localhost:11434

# 6. Web & API Network Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
