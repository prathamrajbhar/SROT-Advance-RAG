# ==============================================================================
# SROT Enterprise Configuration (.env)
# ==============================================================================

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srot
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object Storage (AWS S3 or LocalStack)
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=srot-storage
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# LLM & Model Provider Configuration
# ==============================================================================
# Options for LLM_PROVIDER: 'ollama', 'anthropic', 'gemini', 'openai', 'groq', 'vllm'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Provide the API key for your active LLM_PROVIDER:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# If using Ollama or vLLM:
LLM_BASE_URL=http://localhost:11434/v1

# ==============================================================================
# Embedding & Reranker Services
# ==============================================================================
# Options: 'local' (BAAI bge-large-en-v1.5), 'openai', 'gemini', 'voyage'
EMBEDDING_PROVIDER=local
EMBEDDER_URL=http://localhost:8001

# Options: 'local' (BAAI bge-reranker-v2-m3), 'cohere', 'jina'
RERANKER_PROVIDER=local
RERANKER_URL=http://localhost:8002

# Audio Transcription (ASR)
WHISPER_URL=http://localhost:8003
INTERNAL_MODEL_TOKEN=internal_secret_token

# ==============================================================================
# Observability & Tracing (Langfuse)
# ==============================================================================
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-test
LANGFUSE_SECRET_KEY=sk-lf-test

# ==============================================================================
# RAG Tuning Parameters
# ==============================================================================
RERANK_MIN_SCORE=0.35
CHUNK_CHILD_TOKENS=250
CHUNK_PARENT_TOKENS=1500
HYBRID_TOP_K=40
LLM_TOP_K_PARENTS=8
RATE_LIMIT_CHAT_PER_HOUR=60
