# Copy to .env and fill in real values: cp .env.example .env

# Local dev runs Postgres in Docker on the dedicated 7432 host port
# (see infra/docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://private_pgsql:apple@localhost:7432/srot

# development | test | production
ENVIRONMENT=development

# Origins allowed to call the API with credentials.
CORS_ORIGINS=["http://localhost:3000"]
