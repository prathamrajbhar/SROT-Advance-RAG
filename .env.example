# ==============================================================================
# SROT Enterprise Configuration (.env)
# ==============================================================================

# Database & Cache (Dedicated Isolated Docker Services)
DATABASE_URL=postgresql+asyncpg://private_pgsql:apple@localhost:7432/srot
REDIS_URL=redis://localhost:7379/0

# Vector Database (Qdrant on Dedicated Port)
QDRANT_URL=http://localhost:7333
QDRANT_API_KEY=

# Object Storage (LocalStack on Dedicated Port or AWS S3)
S3_ENDPOINT_URL=http://localhost:7566
S3_REGION=us-east-1
S3_BUCKET=srot-storage
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# LLM & Model Provider Configuration
# Supported LLM_PROVIDER options:
#   - 'ollama'     : Local Ollama server (e.g. LLM_MODEL=llama3.1:8b, gpt-oss:20b-cloud)
#   - 'openai'     : OpenAI models (e.g. LLM_MODEL=gpt-4o, gpt-4o-mini; requires OPENAI_API_KEY)
#   - 'anthropic'  : Anthropic Claude (e.g. LLM_MODEL=claude-3-5-sonnet-20241022; requires ANTHROPIC_API_KEY)
#   - 'gemini'     : Google Gemini (e.g. LLM_MODEL=gemini-2.0-flash; requires GEMINI_API_KEY)
#   - 'groq'       : Groq high-speed cloud (e.g. LLM_MODEL=llama-3.3-70b-versatile; requires GROQ_API_KEY)
#   - 'deepseek'   : DeepSeek API (e.g. LLM_MODEL=deepseek-chat; requires DEEPSEEK_API_KEY)
#   - 'openrouter' : OpenRouter gateway (e.g. LLM_MODEL=meta-llama/llama-3.1-70b-instruct; requires OPENROUTER_API_KEY)
#   - 'mistral'    : Mistral AI (e.g. LLM_MODEL=mistral-large-latest; requires MISTRAL_API_KEY)
#   - 'together'   : Together AI (e.g. LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo; requires TOGETHER_API_KEY)
#   - 'vllm'       : Self-hosted vLLM endpoint (e.g. LLM_MODEL=meta-llama/Llama-3-8B-Instruct)
#   - 'custom'     : Any custom OpenAI-compatible endpoint (requires LLM_BASE_URL)
# ==============================================================================
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# API Keys (set the key for your active LLM_PROVIDER):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Optional: Custom base URL override (only needed for custom, self-hosted, or non-default endpoints)
# LLM_BASE_URL=http://localhost:11434/v1

# ==============================================================================
# Embedding & Reranker Services (100% Open Source Workspace In-Process)
# ==============================================================================
# Models are downloaded into the './models' folder during 'npm run setup' and loaded in-process.
# Options for EMBEDDING_PROVIDER: 'local' (workspace in-process), 'ollama'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Options for RERANKER_PROVIDER: 'local' (workspace in-process cross-encoder)
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-base

# Audio Transcription (Local Whisper ASR)
WHISPER_URL=http://localhost:8003
INTERNAL_MODEL_TOKEN=internal_secret_token



# ==============================================================================
# Observability & Tracing (Langfuse)
# ==============================================================================
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-test
LANGFUSE_SECRET_KEY=sk-lf-test

# ==============================================================================
# RAG Tuning Parameters
# ==============================================================================
RERANK_MIN_SCORE=0.35
CHUNK_CHILD_TOKENS=250
CHUNK_PARENT_TOKENS=1500
HYBRID_TOP_K=40
LLM_TOP_K_PARENTS=8
RATE_LIMIT_CHAT_PER_HOUR=60
