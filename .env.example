# Database: PostgreSQL URL (port 7006)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:7006/<dbname>

# Vector & Cache Infrastructure
REDIS_URL=redis://localhost:7379/0
QDRANT_URL=http://localhost:7333

# BYOK Cryptographic Vault (AES-256-GCM 32-byte hex key)
ENCRYPTION_MASTER_KEY=<32_byte_hex_key>


# Runtime: development | test | production
ENVIRONMENT=development

# Origins allowed to call the API with credentials.
CORS_ORIGINS=["http://localhost:3000"]

