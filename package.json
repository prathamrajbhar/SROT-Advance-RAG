{
  "name": "srot-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Next.js + FastAPI production template",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "cd apps/web && npm run dev",
    "test": "npm run test:api",
    "test:api": "cd apps/api && .venv/bin/pytest -v",
    "typecheck": "cd apps/web && npm run typecheck",
    "migrate": "cd apps/api && .venv/bin/alembic upgrade head",
    "health": "bash scripts/check-health.sh"
  },

  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
